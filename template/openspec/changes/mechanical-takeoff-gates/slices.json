{
  "version": 1,
  "change": "mechanical-takeoff-gates",
  "gate": {
    "test": "python3 -m pytest -q tests",
    "lint": "python3 -m compileall -q template/.claude/hooks",
    "typecheck": null,
    "full_suite_sec": 7.2
  },
  "slices": [
    {
      "id": "S1",
      "title": "判定脚本 session-model.py（读转录 → 别名，fail-closed）",
      "scenarios": [
        "model-routing#session-model-resolves-alias",
        "model-routing#session-model-latest-wins",
        "model-routing#session-model-skips-sidechain",
        "model-routing#session-model-fails-closed"
      ],
      "owns": [
        "template/.claude/hooks/session-model.py",
        "tests/test_session_model.py"
      ],
      "deps": [],
      "verify": "python3 -m pytest -q tests/test_session_model.py",
      "packet": "slices/S1.md"
    },
    {
      "id": "S2",
      "title": "收口路由对账：session-decompose.py --expect-models",
      "scenarios": [
        "model-routing#route-audit-flags-mismatch",
        "model-routing#route-audit-passes-on-match"
      ],
      "owns": [
        "template/.claude/hooks/session-decompose.py",
        "tests/test_evidence_timeline.py"
      ],
      "deps": [
        "S1"
      ],
      "verify": "python3 -m pytest -q tests/test_evidence_timeline.py",
      "packet": "slices/S2.md"
    },
    {
      "id": "S3",
      "title": "接线与文档：opsx-apply / apply skill / pr-ship / README / WORKFLOW / snippet / CLAUDE.md / install.sh",
      "scenarios": [
        "model-routing#apply-resolves-main-model",
        "model-routing#pr-ship-resolves-main-model",
        "model-routing#docs-state-mechanical-resolution",
        "takeoff-approval#apply-checks-approval-gate"
      ],
      "owns": [
        "template/.claude/commands/opsx-apply.md",
        "template/.claude/commands/pr-ship.md",
        "template/.claude/skills/openspec-apply-change/SKILL.md",
        "README.md",
        "docs/WORKFLOW_zh.md",
        "template/CLAUDE.md.snippet",
        "CLAUDE.md",
        "install.sh",
        "tests/test_template_docs.py",
        "tests/test_docs_iron_rules.py"
      ],
      "deps": [],
      "verify": "python3 -m pytest -q tests/test_template_docs.py tests/test_docs_iron_rules.py",
      "packet": "slices/S3.md"
    },
    {
      "id": "S4",
      "title": "起飞批准门禁 takeoff-gate.py（CLI + PreToolUse hook）与 propose 硬交接",
      "scenarios": [
        "takeoff-approval#approval-gate-accepts-human-command",
        "takeoff-approval#approval-gate-rejects-self-start",
        "takeoff-approval#approval-gate-requires-fresh-approval",
        "takeoff-approval#takeoff-hook-denies-unapproved-dispatch",
        "takeoff-approval#takeoff-hook-ignores-unrelated-dispatch",
        "takeoff-approval#propose-ends-with-handoff"
      ],
      "owns": [
        "template/.claude/hooks/takeoff-gate.py",
        "template/.claude/hooks/hooks.json",
        "template/.claude/commands/opsx-propose.md",
        "template/.claude/skills/openspec-propose/SKILL.md",
        "tests/test_approval_gate.py"
      ],
      "deps": [
        "S1"
      ],
      "verify": "python3 -m pytest -q tests/test_approval_gate.py",
      "packet": "slices/S4.md"
    }
  ],
  "scenario_tests": {
    "model-routing#session-model-resolves-alias": "tests/test_session_model.py::test_session_model_resolves_alias",
    "model-routing#session-model-latest-wins": "tests/test_session_model.py::test_session_model_latest_wins",
    "model-routing#session-model-skips-sidechain": "tests/test_session_model.py::test_session_model_skips_sidechain",
    "model-routing#session-model-fails-closed": "tests/test_session_model.py::test_session_model_fails_closed",
    "model-routing#route-audit-flags-mismatch": "tests/test_evidence_timeline.py::test_route_audit_flags_mismatch",
    "model-routing#route-audit-passes-on-match": "tests/test_evidence_timeline.py::test_route_audit_passes_on_match",
    "model-routing#apply-resolves-main-model": "tests/test_template_docs.py::test_apply_resolves_main_model",
    "model-routing#pr-ship-resolves-main-model": "tests/test_template_docs.py::test_pr_ship_resolves_main_model",
    "model-routing#docs-state-mechanical-resolution": "tests/test_docs_iron_rules.py::test_docs_state_mechanical_resolution",
    "takeoff-approval#apply-checks-approval-gate": "tests/test_template_docs.py::test_apply_checks_approval_gate",
    "takeoff-approval#approval-gate-accepts-human-command": "tests/test_approval_gate.py::test_approval_gate_accepts_human_command",
    "takeoff-approval#approval-gate-rejects-self-start": "tests/test_approval_gate.py::test_approval_gate_rejects_self_start",
    "takeoff-approval#approval-gate-requires-fresh-approval": "tests/test_approval_gate.py::test_approval_gate_requires_fresh_approval",
    "takeoff-approval#takeoff-hook-denies-unapproved-dispatch": "tests/test_approval_gate.py::test_takeoff_hook_denies_unapproved_dispatch",
    "takeoff-approval#takeoff-hook-ignores-unrelated-dispatch": "tests/test_approval_gate.py::test_takeoff_hook_ignores_unrelated_dispatch",
    "takeoff-approval#propose-ends-with-handoff": "tests/test_approval_gate.py::test_propose_ends_with_handoff"
  }
}
